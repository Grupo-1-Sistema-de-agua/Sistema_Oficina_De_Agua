#--------------------------------------------------------------------
# Variables para Docker Compose (contenedor de MariaDB)
#--------------------------------------------------------------------
DB_ROOT_PASSWORD=cambiar_password
DB_NAME=agua_db
DB_USER=agua_user
DB_PASSWORD=cambiar_password

#--------------------------------------------------------------------
# Variables para CodeIgniter 4 (app/Config/Database.php las lee de aqui)
# IMPORTANTE: deben tener los MISMOS valores que las de arriba.
# hostname = db porque "db" es el nombre del servicio en docker-compose,
# no localhost (la app y la base de datos corren en contenedores distintos).
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

database.default.hostname = db
database.default.database = agua_db
database.default.username = agua_user
database.default.password = cambiar_password
database.default.DBDriver = MySQLi
database.default.port = 3306

app.baseURL = 'http://localhost:8000/'